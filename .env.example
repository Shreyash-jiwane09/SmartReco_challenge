# Application
APP_NAME=SmartReco
APP_VERSION=0.7.0
ENVIRONMENT=development
DEBUG=false

# API
API_V1_PREFIX=/api/v1
DOCS_URL=/docs
REDOC_URL=/redoc
OPENAPI_URL=/openapi.json

# Database
DATABASE_URL=postgresql://smartreco:smartreco@localhost:5432/smartreco
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800

# AI / vector search
# Obtain a Mesh API key from https://meshapi.ai. Leave blank until vector indexing is enabled.
MESH_API_KEY=
MESH_EMBEDDING_MODEL=sentence-transformers/all-minilm-l6-v2
MESH_CHAT_MODEL=openai/gpt-4o-mini
CHROMA_COLLECTION_NAME=smartreco_products
CHROMA_PERSIST_DIRECTORY=./data/chroma

# Optional LangSmith observability. Leave tracing disabled for normal operation.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=smartreco

# Scheduled recommendation processing. Enable in one application process only.
SCHEDULER_ENABLED=false
RECOMMENDATION_DIGEST_HOUR=9
RECOMMENDATION_DIGEST_MINUTE=0
RECOMMENDATION_DIGEST_TIMEZONE=UTC

# Optional SMTP delivery for scheduled recommendation digests.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10

# Security
# Generate a unique, high-entropy value for every non-development environment.
SECRET_KEY=replace-with-a-unique-secret-key-at-least-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# CORS
# Comma-separated origins are supported; JSON arrays are also accepted.
CORS_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Authorization,Content-Type,X-Request-ID
